{
  // A static site served by Workers Static Assets, which Cloudflare recommends
  // over Pages for new projects. The one Worker script answers /go/<topic>
  // redirects; every other request is served from the built directory.
  "name": "panel-assistant-io",
  "main": "index.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/downloads/webview/*",
      "/go/*",
      "/go",
      "/comments",
      "/comments/count",
      "/oauth/*",
      "/hardware*",
      "/de/hardware*",
      "/es/hardware*",
      "/fr/hardware*",
      "/it/hardware*",
      "/nl/hardware*",
      "/pl/hardware*",
      "/uk/hardware*",
      "/zh-hans/hardware*",
    ],
  },
  // Anonymous comments are limited per address. Cloudflare keeps and expires the counter; the
  // Worker stores nothing. Worker secrets: GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY (PKCS#8) and
  // TURNSTILE_SECRET_KEY for comments; GITHUB_OAUTH_CLIENT_ID and GITHUB_OAUTH_CLIENT_SECRET for
  // editor sign-in at /oauth/.
  "r2_buckets": [
    { "binding": "WEBVIEWS", "bucket_name": "panel-assistant-webviews" },
    { "binding": "PUBLIC_IMAGES", "bucket_name": "panel-assistant-assets" },
  ],
  "ratelimits": [
    { "name": "COMMENT_RATE", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } },
  ],
  // Unknown /go topics are counted here, topic only, so a topic shipped before
  // the site learned it shows up. Read with `node worker/misses-report.mjs`.
  "analytics_engine_datasets": [{ "binding": "GO_MISSES", "dataset": "panel_assistant_go_misses" }],
  // Declaring the apex here keeps the live hostname part of the reviewed
  // configuration: a deploy reconciles it rather than it living only as state
  // someone set by hand in the dashboard.
  "routes": [
    {
      "pattern": "panel-assistant.io",
      "custom_domain": true,
    },
  ],
}
