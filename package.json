{
  "name": "panel-assistant.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node src/build-info/write.mjs && node src/editor/copy-bundle.mjs && node src/brand/generate.mjs && node src/screenshots/generate.mjs && node src/firmware/generate.mjs && node src/settings/generate.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node src/build-info/write.mjs && node src/editor/copy-bundle.mjs && node src/brand/generate.mjs && node src/screenshots/generate.mjs && node src/firmware/generate.mjs && node src/settings/generate.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "node src/build-info/write.mjs && node src/firmware/generate.mjs && node src/settings/generate.mjs",
    "check": "astro check",
    "test": "node --test \"worker/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "format": "prettier --write \"src/**/*.{astro,ts,js,mjs,md,mdx,json,css}\" \"worker/**/*.{js,mjs,json,jsonc}\" \".github/**/*.yml\" \"*.{mjs,md}\" package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{astro,ts,js,mjs,md,mdx,json,css}\" \"worker/**/*.{js,mjs,json,jsonc}\" \".github/**/*.yml\" \"*.{mjs,md}\" package.json tsconfig.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "proseWrap": "preserve",
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "astro": "^7.4.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@sveltia/cms": "0.248.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "satteri": "^0.10.5",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^5.9.3"
  }
}
