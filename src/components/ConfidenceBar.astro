---
// A panel's confidence as a bar that fills and turns from grey to green. No number is shown: the
// score only orders and colours the bar. Hovering, focusing or tapping it opens a list of every
// kind of evidence, each marked as held, partly held or missing; `open` shows that list in place.
import { confidence, confidenceChecklist } from '../hardware/catalogue.mjs';
import type english from '../content/i18n/en.json';

const {
  data,
  wide = false,
  open = false,
} = Astro.props as { data: Record<string, unknown>; wide?: boolean; open?: boolean };
const translate = Astro.locals.t;
const { score } = confidence(data);
const checklist = confidenceChecklist(data).map((item) => ({
  ...item,
  text: translate(item.key as keyof typeof english).replace('{android}', String(data.android)),
}));
const MARK = { hit: '✓', part: '◐', miss: '✗' } as Record<string, string>;
const SAID = {
  hit: translate('confidence.yes'),
  part: translate('confidence.partly'),
  miss: translate('confidence.no'),
} as Record<string, string>;
const label = `${translate('confidence.title')}: ${checklist.map((c) => `${c.text}: ${SAID[c.state]}`).join('; ')}`;
// Grey up to 3, then colour comes in slowly so only the top scores read as clearly green.
const t = Math.max(0, (score - 3) / 7) ** 1.5;
const fill = `hsl(${Math.round(90 + 50 * t)} ${Math.round(70 * t)}% 44%)`;
---

<span class:list={['confidence-wrap', { open }]} tabindex={open ? undefined : 0}>
  <span class:list={['confidence', { wide }]} role="img" aria-label={label}>
    <span class="fill" style={`width: ${score * 10}%; background: ${fill};`}></span>
  </span>
  <span class="detail" aria-hidden="true">
    <span class="detail-title">{translate('confidence.title')}</span>
    {checklist.map((c) => (
      <span class:list={['item', c.state]}>
        <span class="mark">{MARK[c.state]}</span>
        {c.text}
      </span>
    ))}
  </span>
</span>

<style>
  .confidence-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  .confidence-wrap:not(.open) {
    cursor: help;
    padding: 0.375rem 0;
  }
  .confidence-wrap.open {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .confidence {
    display: inline-block;
    width: 4.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    overflow: hidden;
  }
  .confidence.wide {
    width: 10rem;
    height: 0.625rem;
  }
  .fill {
    display: block;
    height: 100%;
    border-radius: inherit;
  }
  .detail {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--sl-text-sm);
    line-height: 1.35;
    color: var(--sl-color-white);
    white-space: normal;
  }
  .confidence-wrap:not(.open) .detail {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 10;
    width: max-content;
    max-width: min(18rem, 80vw);
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 25%);
  }
  .confidence-wrap.open .detail,
  .confidence-wrap:hover .detail,
  .confidence-wrap:focus-within .detail {
    display: flex;
  }
  .confidence-wrap:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  .detail-title {
    font-weight: 600;
  }
  .confidence-wrap.open .detail-title {
    display: none;
  }
  .item {
    display: flex;
    gap: 0.5rem;
  }
  .mark {
    flex: none;
    width: 1em;
    font-weight: 700;
    text-align: center;
  }
  .hit .mark {
    color: hsl(140 60% 40%);
  }
  .part .mark {
    color: hsl(45 85% 45%);
  }
  .miss {
    color: var(--sl-color-gray-3);
  }
  .miss .mark {
    color: hsl(0 60% 55%);
  }
</style>
