---
// Starlight's footer, with comments above it on documentation pages and, below it, one line with
// our thanks to Home Assistant on the left, when the page was last updated in the middle, and the
// build of the site on the right. Starlight's own last-updated row is emptied (LastUpdated.astro).
import Default from '@astrojs/starlight/components/Footer.astro';
import build from '../build-info/build.json';
import Comments from './Comments.astro';

const { entry, lang, lastUpdated } = Astro.locals.starlightRoute;
const isDoc = entry.data.template !== 'splash';

const label =
  build.number === null
    ? 'Unnumbered local build'
    : `Build ${build.number} · ${build.sha}${build.channel === 'main' ? '' : ' · ' + build.channel}`;
---

{isDoc && <Comments />}
<Default />
<div class="site-foot">
  <p class="thanks">
    We{' '}
    <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="love">
      <path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.2 0 3.7 1.2 5.4 3.3 1.7-2.1 3.2-3.3 5.4-3.3 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z"></path>
    </svg>{' '}
    <a href="https://www.home-assistant.io/">Home Assistant</a> and everything the{' '}
    <a href="https://www.openhomefoundation.org/">Open Home Foundation</a> does.
  </p>
  {lastUpdated && (
    <p class="updated">
      {Astro.locals.t('page.lastUpdated')}{' '}
      <time datetime={lastUpdated.toISOString()}>
        {lastUpdated.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' })}
      </time>
    </p>
  )}
  <p class="build-info">
    <a href="/build.json">{label}</a>
  </p>
</div>

<style>
  /* Starlight's meta row is empty now that the date lives on this line. */
  :global(footer .meta:empty) {
    display: none;
  }
  .site-foot {
    display: grid;
    gap: 0.25rem;
    margin: 3rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .site-foot p {
    margin: 0;
  }
  @media (min-width: 50rem) {
    .site-foot {
      grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr);
      align-items: baseline;
      gap: 1.5rem;
    }
    .thanks {
      grid-column: 1;
    }
    .updated {
      grid-column: 2;
      text-align: center;
    }
    .build-info {
      grid-column: 3;
      text-align: end;
    }
  }
  .site-foot a {
    color: inherit;
    text-decoration: none;
  }
  .thanks a {
    color: var(--sl-color-gray-2);
  }
  .site-foot a:hover {
    color: var(--sl-color-white);
  }
  .build-info a {
    font-variant-numeric: tabular-nums;
  }
  .heart {
    width: 1em;
    height: 1em;
    vertical-align: -0.125em;
    fill: #e5484d;
  }
</style>
