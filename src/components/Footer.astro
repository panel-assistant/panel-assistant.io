---
// Starlight's footer, with comments above it on documentation pages and, below it, one line with
// our thanks to Home Assistant on the left and the build of the site on the right.
import Default from '@astrojs/starlight/components/Footer.astro';
import build from '../build-info/build.json';
import Comments from './Comments.astro';

const isDoc = Astro.locals.starlightRoute.entry.data.template !== 'splash';

const label =
  build.number === null
    ? 'Unnumbered local build'
    : `Build ${build.number} · ${build.sha}${build.channel === 'main' ? '' : ' · ' + build.channel}`;
---

{isDoc && <Comments />}
<Default />
<div class="site-foot">
  <p class="thanks">
    We{' '}
    <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="love">
      <path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.2 0 3.7 1.2 5.4 3.3 1.7-2.1 3.2-3.3 5.4-3.3 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z"></path>
    </svg>{' '}
    <a href="https://www.home-assistant.io/">Home Assistant</a> and everything the{' '}
    <a href="https://www.openhomefoundation.org/">Open Home Foundation</a> does.
  </p>
  <p class="build-info">
    <a href="/build.json">{label}</a>
  </p>
</div>

<style>
  .site-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .site-foot p {
    margin: 0;
  }
  .build-info {
    margin-inline-start: auto;
  }
  .site-foot a {
    color: inherit;
    text-decoration: none;
  }
  .thanks a {
    color: var(--sl-color-gray-2);
  }
  .site-foot a:hover {
    color: var(--sl-color-white);
  }
  .build-info a {
    font-variant-numeric: tabular-nums;
  }
  .heart {
    width: 1em;
    height: 1em;
    vertical-align: -0.125em;
    fill: #e5484d;
  }
</style>
