---
// One header for the homepage and every documentation page: the site title, the three areas of
// the site, search, the language picker, the Discord and GitHub links, the theme toggle and a way
// into the docs. Paths are read and written inside the current language.
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';

const { locale } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const prefix = locale ? `/${locale}` : '';
const path = Astro.url.pathname.slice(prefix.length) || '/';
const inArea = (area: string) => path.startsWith(area);
const onHome = path === '/';

const areas = [
  {
    label: t('header.documentation'),
    href: `${prefix}/start/getting-started/`,
    current: !onHome && !inArea('/hardware/') && !inArea('/reference/'),
  },
  { label: t('header.hardware'), href: `${prefix}/hardware/`, current: inArea('/hardware/') },
  { label: t('header.reference'), href: `${prefix}/reference/`, current: inArea('/reference/') },
];
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav class="areas" aria-label={t('header.nav')}>
    {areas.map((a) => (
      <a href={a.href} aria-current={a.current ? 'true' : undefined}>
        {a.label}
      </a>
    ))}
  </nav>
  <div class="sl-flex print:hidden search">
    <Search />
  </div>
  <div class="right-group print:hidden">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
    <a class="get-started" href={`${prefix}/start/getting-started/`}>
      {t('header.get_started')}
    </a>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    flex: none;
  }
  .areas {
    display: none;
    gap: 0.25rem;
  }
  .areas a {
    font-family: var(--pa-font-display);
    font-weight: 600;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-decoration: none;
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    white-space: nowrap;
  }
  .areas a:hover,
  .areas a[aria-current] {
    color: var(--sl-color-white);
    background: var(--pa-sunk);
  }
  .search {
    margin-inline-start: auto;
  }
  /* Wide enough to read as a field you type into, not a button. */
  @media (min-width: 50rem) {
    .search {
      flex: 0 1 18rem;
      min-width: 10rem;
    }
  }
  .right-group {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }
  .social-icons {
    gap: 1rem;
    align-items: center;
    padding-inline: 0.25rem;
  }
  .social-icons :global(a) {
    font-size: 1.35rem;
  }
  .get-started {
    display: none;
    font-family: var(--pa-font-display);
    font-weight: 700;
    font-size: var(--sl-text-sm);
    white-space: nowrap;
    text-decoration: none;
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent);
    padding: 0.5rem 0.9rem;
    border-radius: 0.6rem;
  }
  .get-started:hover {
    filter: brightness(1.08);
  }
  /* The language picker shows its icon only: the header has no room for a language name. */
  .right-group :global(starlight-lang-select select) {
    width: 3.75rem;
    color: transparent;
  }
  /* The homepage has no mobile menu, so its header keeps the language picker and the theme toggle;
     at phone width the Discord and GitHub links give way to them (the page links both lower down). */
  :global(:root[data-has-hero]) .right-group {
    display: flex;
  }
  @media (max-width: 49.99rem) {
    :global(:root[data-has-hero]) .social-icons {
      display: none;
    }
  }
  @media (min-width: 50rem) {
    .right-group {
      display: flex;
    }
  }
  @media (min-width: 64rem) {
    .areas {
      display: flex;
    }
  }
  /* Tighter area links until the header has room, so longer translations still fit. */
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .areas {
      gap: 0;
    }
    .areas a {
      padding-inline: 0.45rem;
    }
  }
  /* The Documentation link above does the same job until there is room for both. */
  @media (min-width: 80rem) {
    .get-started {
      display: flex;
    }
  }
</style>
