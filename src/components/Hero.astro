---
// The homepage hero: the headline, what the product is, the ways in, and a wall panel showing a
// Home Assistant dashboard drawn in Home Assistant's own colours for the current theme.
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const heart =
  'M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.2 0 3.7 1.2 5.4 3.3 1.7-2.1 3.2-3.3 5.4-3.3 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z';
const facts = ['Free and open source', 'Home Assistant 2026.8.3+', 'Android 8.0+ panels'];

const bulb =
  'M12 2a7 7 0 0 0-4 12.7V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.3A7 7 0 0 0 12 2zM9 20h6v1a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1z';
const cards = [
  { name: 'Kitchen', state: 'On · 80%', tone: 'lit', icon: bulb },
  {
    name: 'Front door',
    state: 'Locked',
    tone: 'blue',
    icon: 'M17 9V7a5 5 0 0 0-10 0v2a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2zm-8-2a3 3 0 0 1 6 0v2H9z',
  },
  {
    name: 'Garage',
    state: 'Closed',
    tone: 'blue',
    icon: 'M3 10l9-6 9 6v10h-2v-9H5v9H3zm4 3h10v2H7zm0 3h10v2H7z',
  },
  { name: 'Hallway', state: 'Off', tone: '', icon: bulb },
  { name: 'Sofa lamp', state: 'On · 35%', tone: 'lit', icon: 'M4 14h16v4H4zM6 8h12l2 5H4z' },
  { name: 'Energy', state: '1.2 kW now', tone: 'lit', icon: 'M13 2 4 14h6l-1 8 9-12h-6z' },
];
const lastCards = [
  {
    name: 'Washer',
    state: '12 min left',
    tone: 'blue',
    icon: 'M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm6 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM7 4.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
  },
  {
    name: 'Blinds',
    state: '60% open',
    tone: '',
    icon: 'M4 3h16v2H4zm1 3h14v3H5zm0 4h14v3H5zm0 4h14v3H5zm6 4h2v3h-2z',
  },
];
---

<div class="hero not-content">
  <div class="words">
    <p class="eyebrow">
      Made with
      <svg viewBox="0 0 24 24" role="img" aria-label="love">
        <path d={heart} />
      </svg>
      for Home Assistant, and nothing else
    </p>
    <h1 id="_top" data-page-title set:html={title} />
    <p class="sub">
      Your wall panels, the way you imagined them <em>before reality hit.</em>
    </p>
    {tagline && <p class="lede" set:html={tagline} />}
    <div class="actions">
      {actions.map(({ text, link, variant = 'primary' }) => (
        <a class:list={['action', variant]} href={link}>
          {text}
          {variant === 'primary' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          )}
        </a>
      ))}
    </div>
    <ul class="facts">
      {facts.map((f) => (
        <li>{f}</li>
      ))}
    </ul>
  </div>

  <figure class="scene">
    <div
      class="panel"
      role="img"
      aria-label="A widescreen wall panel showing a Home Assistant dashboard with lights, a thermostat, locks, energy use and the weather"
    >
      <div class="ha">
        <div class="ha-bar">
          <span class="on">Home</span>
          <span>Lights</span>
          <span>Climate</span>
          <span>Security</span>
          <em>18:42</em>
        </div>
        <div class="ha-grid">
          {cards.slice(0, 1).map((c) => (
            <div class:list={['card', c.tone]}>
              <div class="ico">
                <svg viewBox="0 0 24 24">
                  <path d={c.icon} />
                </svg>
              </div>
              <div>
                <b>{c.name}</b>
                <small>{c.state}</small>
              </div>
            </div>
          ))}
          <div class="card tall">
            <div class="dial">
              <svg viewBox="0 0 100 100">
                <circle class="track" cx="50" cy="50" r="40" stroke-dasharray="188 64"></circle>
                <circle class="heat" cx="50" cy="50" r="40" stroke-dasharray="118 134"></circle>
              </svg>
              <strong>21.5°</strong>
            </div>
            <div>
              <b>Living room</b>
              <small>Heating to 21.5 °C</small>
            </div>
          </div>
          {cards.slice(1).map((c) => (
            <div class:list={['card', c.tone]}>
              <div class="ico">
                <svg viewBox="0 0 24 24">
                  <path d={c.icon} />
                </svg>
              </div>
              <div>
                <b>{c.name}</b>
                <small>{c.state}</small>
              </div>
            </div>
          ))}
          <div class="card wide blue">
            <div class="ico">
              <svg viewBox="0 0 24 24">
                <path d="M7 19a5 5 0 0 1-.6-9.96A6.5 6.5 0 0 1 19 10.5 4.25 4.25 0 0 1 18 19z"></path>
              </svg>
            </div>
            <div>
              <b>Cloudy · 14 °C</b>
              <small>Rain from 21:00</small>
            </div>
          </div>
          {lastCards.map((c) => (
            <div class:list={['card', c.tone]}>
              <div class="ico">
                <svg viewBox="0 0 24 24">
                  <path d={c.icon} />
                </svg>
              </div>
              <div>
                <b>{c.name}</b>
                <small>{c.state}</small>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <figcaption>Your own Home Assistant dashboard on the wall, not a lookalike app.</figcaption>
  </figure>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 3.5rem;
    align-items: center;
    padding-block: 2.5rem 2rem;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font: 700 0.75rem/1.2 var(--pa-font-display);
    color: var(--sl-color-text-accent);
  }
  .eyebrow svg {
    width: 1.05em;
    height: 1.05em;
    fill: #e5484d;
  }
  h1 {
    font: 800 clamp(2.5rem, 5.4vw, 4.25rem) / 1 var(--pa-font-display);
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    margin: 1.1rem 0 0;
    max-width: 10.5em;
    text-wrap: balance;
  }
  h1 :global(span) {
    color: var(--sl-color-text-accent);
  }
  .sub {
    font: 600 clamp(1.2rem, 2vw, 1.45rem) / 1.3 var(--pa-font-display);
    letter-spacing: -0.01em;
    color: var(--sl-color-gray-3);
    margin: 1.25rem 0 0;
    max-width: 24em;
  }
  .sub em {
    font-style: normal;
    color: var(--pa-amber);
  }
  .lede {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--sl-color-gray-1);
    margin: 1rem 0 1.9rem;
    max-width: 33em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: 700 1rem/1 var(--pa-font-display);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.8rem 1.25rem;
    border-radius: 0.75rem;
    border: 1.5px solid transparent;
  }
  .action svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }
  .primary:hover {
    filter: brightness(1.08);
  }
  .secondary {
    background: var(--pa-surface);
    border-color: var(--pa-line);
    color: var(--sl-color-white);
  }
  .secondary:hover {
    border-color: var(--sl-color-accent);
  }
  .minimal {
    color: var(--sl-color-text-accent);
    padding-inline: 0.4rem;
  }
  .minimal:hover {
    text-decoration: underline;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .facts li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sl-color-accent);
  }

  .scene {
    width: 100%;
    max-width: calc(760px + 4rem);
    justify-self: end;
    margin: 0;
    border-radius: 1.4rem;
    background: linear-gradient(180deg, var(--pa-wall), var(--sl-color-black) 92%);
    padding: 2.5rem 2rem 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }
  /*
   * The panel is a 16:9 screen drawn at 640 by 360 and scales as one picture: everything inside it
   * is sized in --u, a 640th of the panel's width, so the screen, bezel and cards keep their proportions at
   * every size and content can never stretch the frame.
   */
  .panel {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 760px;
    aspect-ratio: 16 / 9;
    background: var(--pa-bezel);
    border-radius: 2.81% / 5%;
    padding: 2.8%;
    box-shadow: var(--pa-shadow);
  }
  .panel::after {
    content: '';
    position: absolute;
    right: 5%;
    bottom: 1.6%;
    width: calc(5 * 100cqw / 640);
    height: calc(5 * 100cqw / 640);
    border-radius: 50%;
    background: var(--pa-amber);
    box-shadow: 0 0 8px var(--pa-amber);
  }
  .ha {
    --u: calc(100cqw / 640);
    height: 100%;
    border-radius: calc(9 * var(--u));
    background: var(--pa-ha-bg);
    color: var(--pa-ha-text);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    font-family: Roboto, var(--sl-font-system);
  }
  .ha-bar {
    display: flex;
    align-items: center;
    gap: calc(4 * var(--u));
    padding: 0 4%;
    height: calc(36 * var(--u));
    border-bottom: 1px solid var(--pa-ha-divider);
    font-size: calc(11 * var(--u));
    font-weight: 600;
    color: var(--pa-ha-muted);
  }
  .ha-bar span {
    padding: calc(11 * var(--u)) calc(7 * var(--u)) calc(9 * var(--u));
    border-bottom: calc(2 * var(--u)) solid transparent;
  }
  .ha-bar span.on {
    color: var(--pa-ha-primary);
    border-color: var(--pa-ha-primary);
  }
  .ha-bar em {
    margin-left: auto;
    font-style: normal;
    font-weight: 500;
  }
  .ha-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: calc(8 * var(--u));
    padding: calc(8 * var(--u));
    min-height: 0;
  }
  .card {
    background: var(--pa-ha-card);
    border-radius: calc(10 * var(--u));
    padding: calc(8 * var(--u)) calc(10 * var(--u));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--pa-ha-divider);
  }
  .ico {
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--pa-ha-muted) 16%, transparent);
    color: var(--pa-ha-muted);
  }
  .ico svg {
    width: calc(15 * var(--u));
    height: calc(15 * var(--u));
    fill: currentColor;
  }
  .lit .ico {
    background: color-mix(in srgb, var(--pa-ha-on) 22%, transparent);
    color: var(--pa-ha-on);
  }
  .blue .ico {
    background: color-mix(in srgb, var(--pa-ha-primary) 20%, transparent);
    color: var(--pa-ha-primary);
  }
  .card b {
    display: block;
    font-size: calc(11 * var(--u));
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card small {
    display: block;
    font-size: calc(10 * var(--u));
    color: var(--pa-ha-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tall {
    grid-row: span 2;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--u));
    text-align: center;
  }
  .wide {
    grid-column: span 2;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: calc(10 * var(--u));
  }
  .dial {
    position: relative;
    width: 78%;
    max-width: calc(118 * var(--u));
    aspect-ratio: 1;
  }
  .dial svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: rotate(135deg);
  }
  .dial circle {
    fill: none;
    stroke-width: 7;
    stroke-linecap: round;
  }
  .track {
    stroke: var(--pa-ha-divider);
  }
  .heat {
    stroke: #ff9800;
  }
  .dial strong {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: calc(19 * var(--u));
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  @media (max-width: 62rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .scene {
      justify-self: center;
    }
  }
  @media (max-width: 34rem) {
    .scene {
      padding: 1.5rem 1rem 1.2rem;
    }
    .card small {
      display: none;
    }
  }
</style>
