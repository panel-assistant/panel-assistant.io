---
// Starlight's page title, with a small photo gallery below it on hardware panel pages that carry
// vendor product photos. The hardware is sold under many OEM rebrand names (see "Also sold as" on
// each panel page); a photo lets a reader confirm what they own far faster than a product code.
// Gallery slots have a static fallback and can receive the current public image set at request time.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getEntry } from 'astro:content';
import { rewriteAssetUrl, ASSET_BASE } from '../plugins/asset-urls.mjs';
import TranslationNote from './TranslationNote.astro';
import { soldAs, confidence } from '../hardware/catalogue.mjs';
import ConfidenceBar from './ConfidenceBar.astro';
import OwnerReports from './OwnerReports.astro';
import {
  panelIdentity,
  staticGallery,
  renderHero,
  renderGallery,
} from '../product-images/gallery.mjs';
import '../product-images/gallery.css';

const { entry } = Astro.locals.starlightRoute;
const isPanel = entry.id.startsWith('hardware/panels/');
const identity = entry.data.panelIndex ? null : panelIdentity(entry.id);
const photos = identity && Array.isArray(entry.data.photos) ? entry.data.photos : [];
const canonicalEntry =
  identity && identity.locale !== 'en'
    ? await getEntry('docs', `hardware/panels/${identity.id}`)
    : undefined;
const canonicalPhotos = Array.isArray(canonicalEntry?.data.photos)
  ? canonicalEntry.data.photos
  : [];
const model = staticGallery(entry.data, (url: string) => rewriteAssetUrl(url, ASSET_BASE));
const texts = JSON.stringify(
  photos.map((photo) => {
    const credit = photo.credit || entry.data.photoCredit;
    const canonicalPhoto = canonicalPhotos.find((candidate) =>
      photo.id && candidate.id ? photo.id === candidate.id : photo.src === candidate.src,
    );
    return {
      id: photo.id,
      src: photo.src,
      alt: photo.alt,
      credit,
      canonicalCredit:
        identity?.locale === 'en'
          ? credit
          : canonicalPhoto
            ? canonicalPhoto.credit || canonicalEntry?.data.photoCredit
            : undefined,
    };
  }),
);
// Every brand and product name that leads to this page, with how each differs.
const names = isPanel ? soldAs(entry.data) : [];
const evidence =
  isPanel && Array.isArray(entry.data.evidence) ? confidence(entry.data).reasons : null;
const brands = new Set(names.map((n: { brand: string }) => n.brand)).size;
---

<Default />
<TranslationNote />
{identity && (
  <div
    data-panel-images="hero"
    data-panel-model={identity.id}
    data-panel-locale={identity.locale}
    data-panel-texts={texts}
    set:html={renderHero(model)}
  />
)}
{isPanel && entry.data.webview_can_reach && (
  <div class="webview-facts">
    <p>
      <strong>WebView — Ships with:</strong> {String(entry.data.webview_ships_with)}
    </p>
    <p>
      <strong>Can reach:</strong> {String(entry.data.webview_can_reach)}
    </p>
  </div>
)}
{evidence && (
  <div class="confidence-line">
    <span class="confidence-heading">Confidence</span>
    <ConfidenceBar data={entry.data} wide open />
  </div>
)}
{isPanel && entry.data.ownerReports && <OwnerReports reports={entry.data.ownerReports} />}
{names.length > 0 && (
  <div id="sold-as" class="sold-as">
    <p>
      {brands > 1
        ? 'This hardware is sold by several brands. This page covers every name below.'
        : 'This page covers every name below.'}
    </p>
    <table>
      <thead>
        <tr>
          <th scope="col">Brand</th>
          <th scope="col">Name</th>
          <th scope="col">How it differs</th>
        </tr>
      </thead>
      <tbody>
        {names.map((n: { brand: string; name: string; note?: string }, i: number) => (
          <tr>
            <td>{n.brand}</td>
            <td class="name">{n.name}</td>
            <td>{n.note ?? (i === 0 ? 'Main name' : 'Same hardware')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
{identity && (
  <div
    data-panel-images="gallery"
    data-panel-model={identity.id}
    data-panel-locale={identity.locale}
    data-panel-texts={texts}
    set:html={renderGallery(model)}
  />
)}

<style>
  .confidence-heading {
    font-weight: 600;
  }
  .confidence-line {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .sold-as {
    margin: 0.75rem 0 0;
  }
  .sold-as p {
    margin: 0 0 0.5rem;
  }
  .sold-as table {
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  .sold-as th,
  .sold-as td {
    padding: 0.375rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    text-align: start;
    vertical-align: top;
  }
  .sold-as .name {
    white-space: nowrap;
  }
  .sold-as th {
    background: var(--sl-color-gray-6);
  }
</style>

<script>
  function gallerySlot(slot: HTMLElement) {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-panel-images="gallery"]')).find(
      (candidate) =>
        candidate.dataset.panelModel === slot.dataset.panelModel &&
        candidate.dataset.panelLocale === slot.dataset.panelLocale,
    );
  }

  function showPhoto(slot: HTMLElement, index: number) {
    const dialog = slot.querySelector<HTMLDialogElement>('.photo-viewer');
    const thumbs = Array.from(
      slot.querySelectorAll<HTMLButtonElement>('.hardware-photos [data-open-photo]'),
    );
    if (!dialog || !thumbs.length || !Number.isInteger(index)) return null;
    const current = ((index % thumbs.length) + thumbs.length) % thumbs.length;
    const thumb = thumbs[current];
    const source = thumb.querySelector<HTMLImageElement>('img');
    const image = dialog.querySelector<HTMLImageElement>('.photo-viewer-img');
    const caption = dialog.querySelector<HTMLElement>('.photo-viewer-caption');
    if (!source || !image || !caption) return null;
    image.src = thumb.dataset.fullPhoto || source.src;
    image.alt = source.alt;
    caption.textContent =
      thumbs.length > 1 ? `${source.alt} (${current + 1} of ${thumbs.length})` : source.alt;
    dialog.dataset.currentPhoto = String(current);
    dialog.querySelectorAll<HTMLElement>('[data-photo-credit]').forEach((credit) => {
      credit.toggleAttribute('data-active', Number(credit.dataset.photoCredit) === current);
    });
    return dialog;
  }

  // Delegation also covers a runtime gallery on a page whose static image set was empty.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target;
    const slot = target.closest<HTMLElement>('[data-panel-images]');
    if (!slot) return;
    const dialog = target.closest<HTMLDialogElement>('.photo-viewer');
    if (dialog) {
      if (target === dialog || target.closest('[data-close-photo]')) dialog.close();
      else if (target.closest('[data-prev-photo]'))
        showPhoto(slot, Number(dialog.dataset.currentPhoto) - 1);
      else if (target.closest('[data-next-photo]'))
        showPhoto(slot, Number(dialog.dataset.currentPhoto) + 1);
      return;
    }
    const trigger = target.closest<HTMLButtonElement>('[data-open-photo]');
    const gallery = trigger && gallerySlot(slot);
    if (!trigger || !gallery) return;
    const viewer = showPhoto(gallery, Number(trigger.dataset.openPhoto));
    if (viewer && !viewer.open) viewer.showModal();
  });

  document.addEventListener('keydown', (event) => {
    if (!(event.target instanceof Element)) return;
    const dialog = event.target.closest<HTMLDialogElement>('.photo-viewer');
    const slot = dialog?.closest<HTMLElement>('[data-panel-images="gallery"]');
    if (!dialog?.open || !slot || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
    event.preventDefault();
    showPhoto(slot, Number(dialog.dataset.currentPhoto) + (event.key === 'ArrowLeft' ? -1 : 1));
  });
</script>
