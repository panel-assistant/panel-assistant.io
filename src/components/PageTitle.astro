---
// Starlight's page title, with a small photo gallery below it on hardware panel pages that carry
// vendor product photos. The hardware is sold under many OEM rebrand names (see "Also sold as" on
// each panel page); a photo lets a reader confirm what they own far faster than a product code.
// Thumbnails open a larger view (the same asset, just not scaled down as far) with keyboard and
// swipe navigation between shots.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { rewriteAssetUrl, ASSET_BASE } from '../plugins/asset-urls.mjs';
import TranslationNote from './TranslationNote.astro';
import { soldAs, confidence } from '../hardware/catalogue.mjs';
import ConfidenceBar from './ConfidenceBar.astro';

const { entry } = Astro.locals.starlightRoute;
const isPanel = entry.id.startsWith('hardware/panels/');
const photos = isPanel && Array.isArray(entry.data.photos) ? entry.data.photos : [];
const credit = isPanel ? entry.data.photoCredit : undefined;
// Every brand and product name that leads to this page, with how each differs.
const names = isPanel ? soldAs(entry.data) : [];
const evidence =
  isPanel && Array.isArray(entry.data.evidence) ? confidence(entry.data).reasons : null;
const brands = new Set(names.map((n: { brand: string }) => n.brand)).size;
---

<Default />
<TranslationNote />
{evidence && (
  <p class="confidence-line">
    <ConfidenceBar data={entry.data} wide />
    <span>
      {evidence.length ? `Confidence: ${evidence.join(', ')}.` : 'Confidence: not yet assessed.'}
    </span>
  </p>
)}
{names.length > 0 && (
  <div id="sold-as" class="sold-as">
    <p>
      {brands > 1
        ? 'This hardware is sold by several brands. This page covers every name below.'
        : 'This page covers every name below.'}
    </p>
    <table>
      <thead>
        <tr>
          <th scope="col">Brand</th>
          <th scope="col">Name</th>
          <th scope="col">How it differs</th>
        </tr>
      </thead>
      <tbody>
        {names.map((n: { brand: string; name: string; note?: string }, i: number) => (
          <tr>
            <td>{n.brand}</td>
            <td class="name">{n.name}</td>
            <td>{n.note ?? (i === 0 ? 'Main name' : 'Same hardware')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
{photos.length > 0 && (
  <figure class="hardware-photos not-content">
    <ul>
      {photos.map((photo: { src: string; alt: string }, i: number) => (
        <li>
          <button
            type="button"
            class="photo-thumb"
            data-open-photo={i}
            aria-label={`View larger: ${photo.alt}`}
          >
            <img
              src={rewriteAssetUrl(photo.src, ASSET_BASE)}
              alt={photo.alt}
              loading="lazy"
              width="320"
              height="320"
            />
          </button>
        </li>
      ))}
    </ul>
    {credit && <figcaption>{credit}</figcaption>}
  </figure>
)}
{photos.length > 0 && (
  <dialog class="photo-viewer">
    <button type="button" class="photo-viewer-close" data-close-photo aria-label="Close">
      ✕
    </button>
    {photos.length > 1 && (
      <button
        type="button"
        class="photo-viewer-nav photo-viewer-prev"
        data-prev-photo
        aria-label="Previous photo"
      >
        ‹
      </button>
    )}
    <img class="photo-viewer-img" alt="" />
    <p class="photo-viewer-caption"></p>
    {photos.length > 1 && (
      <button
        type="button"
        class="photo-viewer-nav photo-viewer-next"
        data-next-photo
        aria-label="Next photo"
      >
        ›
      </button>
    )}
  </dialog>
)}

<style>
  .confidence-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin: 0.75rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .sold-as {
    margin: 0.75rem 0 0;
  }
  .sold-as p {
    margin: 0 0 0.5rem;
  }
  .sold-as table {
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  .sold-as th,
  .sold-as td {
    padding: 0.375rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    text-align: start;
    vertical-align: top;
  }
  .sold-as .name {
    white-space: nowrap;
  }
  .sold-as th {
    background: var(--sl-color-gray-6);
  }
  .hardware-photos {
    margin: 1rem 0 1.5rem;
  }
  .hardware-photos ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hardware-photos li {
    flex: 0 0 auto;
  }
  .photo-thumb {
    display: block;
    padding: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6, var(--sl-color-gray-7));
    cursor: zoom-in;
    line-height: 0;
  }
  .photo-thumb:hover,
  .photo-thumb:focus-visible {
    border-color: var(--sl-color-gray-3);
  }
  .photo-thumb img {
    display: block;
    width: 9rem;
    height: 9rem;
    object-fit: contain;
    border-radius: calc(0.5rem - 1px);
  }
  .hardware-photos figcaption {
    margin-top: 0.375rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .photo-viewer {
    box-sizing: border-box;
    max-width: min(90vw, 60rem);
    max-height: 90vh;
    margin: auto;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }
  .photo-viewer::backdrop {
    background: rgb(0 0 0 / 70%);
  }
  .photo-viewer-img {
    display: block;
    max-width: 100%;
    max-height: calc(90vh - 6rem);
    margin: 0 auto;
    object-fit: contain;
  }
  .photo-viewer-caption {
    margin: 0.75rem 0 0;
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .photo-viewer-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    cursor: pointer;
  }
  .photo-viewer-close:hover {
    color: var(--sl-color-white);
  }
  .photo-viewer-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .photo-viewer-nav:hover {
    color: var(--sl-color-white);
  }
  .photo-viewer-prev {
    left: 0.5rem;
  }
  .photo-viewer-next {
    right: 0.5rem;
  }
</style>

<script>
  function setUpPhotoViewer() {
    const dialog = document.querySelector<HTMLDialogElement>('.photo-viewer');
    const gallery = document.querySelector('.hardware-photos');
    if (!dialog || !gallery) return;

    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-open-photo]'));
    const photos = thumbs.map((btn) => {
      const img = btn.querySelector('img')!;
      return { src: img.src, alt: img.alt };
    });
    const img = dialog.querySelector<HTMLImageElement>('.photo-viewer-img')!;
    const caption = dialog.querySelector<HTMLElement>('.photo-viewer-caption')!;
    let current = 0;

    function show(index: number) {
      current = (index + photos.length) % photos.length;
      const photo = photos[current];
      img.src = photo.src;
      img.alt = photo.alt;
      caption.textContent =
        photos.length > 1 ? `${photo.alt} (${current + 1} of ${photos.length})` : photo.alt;
    }

    thumbs.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close-photo]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev-photo]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next-photo]')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
  }

  setUpPhotoViewer();
</script>
