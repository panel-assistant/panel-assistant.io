---
// A titled group of link tiles. `boxed` sets the group on its own surface, for the call to help.
interface Props {
  title: string;
  links: { title: string; href: string; text: string }[];
  boxed?: boolean;
}
const { title, links, boxed = false } = Astro.props;
---

<section class:list={['tiles not-content', { boxed }]}>
  <h2>{title}</h2>
  <div class="intro">
    <slot />
  </div>
  <div class="grid">
    {links.map((l) => (
      <a class="tile" href={l.href}>
        <strong>{l.title}</strong>
        <span>{l.text}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .tiles {
    padding: 2.75rem var(--pa-inset);
    border-top: 1px solid var(--pa-line);
  }
  .boxed {
    border: 1px solid var(--pa-line);
    border-radius: 1.1rem;
    background: var(--pa-surface);
    padding: 2.5rem calc(var(--pa-inset) - 1px);
    margin-block: 1rem 2.75rem;
  }
  .boxed + :global(*) {
    border-top: 0;
  }
  h2 {
    font: 800 clamp(1.6rem, 3vw, 2.25rem) / 1.08 var(--pa-font-display);
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
    margin: 0;
  }
  .intro {
    max-width: 44em;
    color: var(--sl-color-gray-3);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .intro :global(p) {
    margin: 0.9rem 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
    margin-top: 1.4rem;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--pa-line);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .tiles:not(.boxed) .tile {
    background: var(--pa-surface);
  }
  .tile:hover {
    border-color: var(--sl-color-accent);
  }
  .tile strong {
    font: 700 1rem/1.3 var(--pa-font-display);
  }
  .tile span {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 62rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
