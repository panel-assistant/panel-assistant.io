---
// The hardware catalogue table, generated from the front matter of every page under
// hardware/panels/. Columns come from the pages, not from a list here.
import { getCollection } from 'astro:content';
import { cellText, collectFields, fieldLabel, nearDuplicates } from '../hardware/fields.mjs';
import { rewriteAssetUrl, ASSET_BASE } from '../plugins/asset-urls.mjs';
import { soldAs } from '../hardware/catalogue.mjs';
import { panelIdentity, staticGallery, renderThumbnail } from '../product-images/gallery.mjs';
import '../product-images/gallery.css';

const panels = (
  await getCollection(
    'docs',
    (e) => e.id.startsWith('hardware/panels/') && !e.data.panelIndex && !!panelIdentity(e.id),
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const fields = collectFields(panels.map((p) => p.data)).filter((field) => field !== 'heroImageId');
const locale = !Astro.currentLocale || Astro.currentLocale === 'root' ? 'en' : Astro.currentLocale;
for (const [a, b] of nearDuplicates(fields)) {
  console.warn(
    `[hardware table] front-matter keys "${a}" and "${b}" look like one field spelled two ways`,
  );
}
const rows = panels.map((p) => {
  const data: Record<string, unknown> = p.data;
  const photos = Array.isArray(data.photos) ? data.photos : [];
  return {
    modelId: panelIdentity(p.id)!.id,
    model: staticGallery(data, (url: string) => rewriteAssetUrl(url, ASSET_BASE)),
    texts: JSON.stringify(
      photos.map((photo) => {
        const credit = photo.credit || data.photoCredit;
        return { id: photo.id, src: photo.src, alt: photo.alt, credit, canonicalCredit: credit };
      }),
    ),
    href: `/${p.id}/`,
    title: p.data.title,
    soldAs: soldAs(data)
      .slice(1)
      .map((n) => `${n.brand} ${n.name}`)
      .join(', '),
    cells: fields.map((f) => cellText(data[f])),
  };
});
---

<div class="hardware-table">
  <table>
    <thead>
      <tr>
        <th scope="col">
          <span class="sr-only">Photo</span>
        </th>
        <th scope="col">Panel</th>
        {fields.map((f) => (
          <th scope="col">{fieldLabel(f)}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td
            class="thumb-cell"
            data-panel-images="thumbnail"
            data-panel-model={r.modelId}
            data-panel-locale={locale}
            data-panel-href={r.href}
            data-panel-texts={r.texts}
            set:html={renderThumbnail(r.model, r.href)}
          />
          <th scope="row">
            <a href={r.href}>{r.title}</a>
            {r.soldAs && <span class="sold-as">Also on this page: {r.soldAs}</span>}
          </th>
          {r.cells.map((c) => (
            <td>{c}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .hardware-table {
    overflow-x: auto;
  }
  .hardware-table table {
    display: table;
    width: 100%;
    font-size: var(--sl-text-sm);
  }
  .hardware-table th {
    white-space: nowrap;
  }
  .hardware-table .sold-as {
    display: block;
    font-weight: normal;
    white-space: normal;
    color: var(--sl-color-gray-3);
  }
  .hardware-table td {
    min-width: 7rem;
  }
  .hardware-table .thumb-cell {
    min-width: 0;
    width: 3rem;
    padding-inline-end: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
