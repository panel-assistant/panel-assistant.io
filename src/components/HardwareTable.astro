---
// The hardware catalogue table, generated from the front matter of every page under
// hardware/panels/. Columns come from the pages, not from a list here.
import { getCollection } from 'astro:content';
import { cellText, collectFields, fieldLabel, nearDuplicates } from '../hardware/fields.mjs';
import { rewriteAssetUrl, ASSET_BASE } from '../plugins/asset-urls.mjs';

const panels = (
  await getCollection('docs', (e) => e.id.startsWith('hardware/panels/') && !e.data.panelIndex)
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const fields = collectFields(panels.map((p) => p.data));
for (const [a, b] of nearDuplicates(fields)) {
  console.warn(
    `[hardware table] front-matter keys "${a}" and "${b}" look like one field spelled two ways`,
  );
}
const rows = panels.map((p) => {
  const data: Record<string, unknown> = p.data;
  const photo = Array.isArray(data.photos) ? data.photos[0] : undefined;
  return {
    href: `/${p.id}/`,
    title: p.data.title,
    thumb: photo ? { src: rewriteAssetUrl(photo.src, ASSET_BASE), alt: photo.alt ?? '' } : null,
    cells: fields.map((f) => cellText(data[f])),
  };
});
---

<div class="hardware-table">
  <table>
    <thead>
      <tr>
        <th scope="col">
          <span class="sr-only">Photo</span>
        </th>
        <th scope="col">Panel</th>
        {fields.map((f) => (
          <th scope="col">{fieldLabel(f)}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="thumb-cell">
            {r.thumb && (
              <a href={r.href} tabindex="-1" aria-hidden="true">
                <img src={r.thumb.src} alt="" loading="lazy" width="48" height="48" />
              </a>
            )}
          </td>
          <th scope="row">
            <a href={r.href}>{r.title}</a>
          </th>
          {r.cells.map((c) => (
            <td>{c}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .hardware-table {
    overflow-x: auto;
  }
  .hardware-table table {
    display: table;
    width: 100%;
    font-size: var(--sl-text-sm);
  }
  .hardware-table th {
    white-space: nowrap;
  }
  .hardware-table td {
    min-width: 7rem;
  }
  .hardware-table .thumb-cell {
    min-width: 0;
    width: 3rem;
    padding-inline-end: 0;
  }
  .hardware-table .thumb-cell img {
    display: block;
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6, var(--sl-color-gray-7));
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
