---
// Comments under a page. Readers with a GitHub account use giscus; everyone else uses the form,
// which the Worker at /comments posts into the same discussion. One discussion per page, found by
// pathname, in the website repository's Discussions.
import config from '../../worker/comments.json';

const { lang } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
// Text the script writes later, in this page's language. Plural forms follow Intl.PluralRules;
// a language names only the forms it uses, and a missing form falls back to "other".
// English has only "one" and "other"; Polish and Ukrainian add "few" and "many".
const forms = ['one', 'few', 'many', 'other'].filter((form) => t.exists(`comments.load.${form}`));
const messages = {
  load: Object.fromEntries(
    forms.map((form) => [form, t(`comments.load.${form}` as 'comments.load.other')]),
  ),
  first: t('comments.first'),
  stopped: t('comments.stopped'),
  posting: t('comments.posting'),
  posted: t('comments.posted'),
  failed: t('comments.failed'),
  errors: Object.fromEntries(
    (['rate', 'challenge', 'empty', 'long', 'unavailable'] as const).map((e) => [
      e,
      t(`comments.error.${e}`),
    ]),
  ),
};
---

<section
  class="comments"
  aria-labelledby="comments-heading"
  data-messages={JSON.stringify(messages)}
>
  <h2 id="comments-heading">
    {t('comments.heading')}
    <span class="count"></span>
  </h2>
  <div class="gate">
    <button
      type="button"
      class="show-comments"
      data-repo={config.repo}
      data-repo-id={config.repoId}
      data-category={config.category}
      data-category-id={config.categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="0"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang={lang}
    >
      {t('comments.load')}
    </button>
    <p class="note">{t('comments.load_note')}</p>
  </div>
  <div class="comments-body" hidden>
    <div class="giscus"></div>
    <details class="anonymous">
      <summary>{t('comments.anonymous')}</summary>
      <form class="anonymous-form" method="post" action="/comments">
        <label>
          {t('comments.name')} <span class="optional">{t('comments.name_note')}</span>
          <input name="name" maxlength={config.maxName} autocomplete="nickname" />
        </label>
        <label>
          {t('comments.comment')}
          <textarea name="body" required maxlength={config.maxBody} rows="5"></textarea>
        </label>
        <p class="note">{t('comments.post_note')}</p>
        <div class="challenge" data-sitekey={config.turnstileSiteKey}></div>
        <button type="submit">{t('comments.post')}</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </details>
    <p class="note autoload">
      <button type="button" class="stop-autoload">
        {t('comments.stop_autoload')}
      </button>
    </p>
  </div>
</section>

<script>
  // Nothing loads from GitHub until a reader asks once. That choice is kept in this browser, and
  // from then on comments load when the reader scrolls near them, so a reader who never reaches
  // them still contacts no third party. Both kinds of reader see the anonymous form only with the
  // comments.
  const PREFERENCE = 'panel-assistant:load-comments';
  const remembered = () => {
    try {
      return localStorage.getItem(PREFERENCE) === 'yes';
    } catch {
      return false;
    }
  };
  const remember = (on: boolean) => {
    try {
      if (on) localStorage.setItem(PREFERENCE, 'yes');
      else localStorage.removeItem(PREFERENCE);
    } catch {
      // Storage refused (a private window, blocked site data): the button simply asks again.
    }
  };

  for (const section of document.querySelectorAll<HTMLElement>('section.comments')) {
    const text = JSON.parse(section.dataset.messages!);
    const plural = new Intl.PluralRules(document.documentElement.lang);
    const gate = section.querySelector<HTMLElement>('.gate')!;
    const button = section.querySelector<HTMLButtonElement>('button.show-comments')!;
    const body = section.querySelector<HTMLElement>('.comments-body')!;
    const stop = section.querySelector<HTMLButtonElement>('button.stop-autoload')!;
    let loaded = false;

    const load = () => {
      if (loaded) return;
      loaded = true;
      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.crossOrigin = 'anonymous';
      s.async = true;
      Object.assign(s.dataset, button.dataset);
      gate.remove();
      body.hidden = false;
      body.querySelector('.giscus')!.after(s);
    };

    button.addEventListener('click', () => {
      remember(true);
      load();
    });
    stop.addEventListener('click', () => {
      remember(false);
      stop.parentElement!.textContent = text.stopped;
    });

    if (remembered()) {
      gate.hidden = true;
      if ('IntersectionObserver' in window) {
        const watch = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            watch.disconnect();
            load();
          },
          { rootMargin: '400px 0px' },
        );
        watch.observe(section);
      } else {
        load();
      }
    }

    // The count comes from this site, so a reader sees there is a conversation before anything
    // loads from GitHub. Without it (a local preview, or GitHub unavailable) the labels stay.
    fetch(`/comments/count?page=${encodeURIComponent(location.pathname)}`)
      .then((res) => (res.ok ? res.json() : null))
      .then((out) => {
        const count = out?.count;
        if (!Number.isInteger(count)) return;
        const form = text.load[plural.select(count)] ?? text.load.other;
        button.textContent = count === 0 ? text.first : form.replace('{count}', String(count));
        if (count > 0) section.querySelector('.count')!.textContent = ` (${count})`;
      })
      .catch(() => {});
  }

  for (const details of document.querySelectorAll<HTMLDetailsElement>('details.anonymous')) {
    const text = JSON.parse(details.closest<HTMLElement>('section.comments')!.dataset.messages!);
    const form = details.querySelector<HTMLFormElement>('form')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const challenge = form.querySelector<HTMLElement>('.challenge')!;
    let widget: string | undefined;

    // Turnstile loads only when someone opens the form, not on every page view.
    details.addEventListener('toggle', () => {
      if (!details.open || document.getElementById('turnstile-api')) return;
      const s = document.createElement('script');
      s.id = 'turnstile-api';
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.onload = () => {
        widget = (window as any).turnstile.render(challenge, {
          sitekey: challenge.dataset.sitekey,
        });
      };
      document.head.append(s);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      data.set('page', location.pathname);
      status.textContent = text.posting;
      try {
        const res = await fetch('/comments', { method: 'POST', body: data });
        const out = await res.json();
        if (res.ok) {
          form.reset();
          status.textContent = text.posted;
        } else {
          status.textContent = text.errors[out.error] ?? text.failed;
        }
      } catch {
        status.textContent = text.failed;
      }
      (window as any).turnstile?.reset(widget);
    });
  }
</script>

<style>
  .comments {
    margin-block: 2rem 1rem;
  }
  .anonymous summary {
    cursor: pointer;
    color: var(--sl-color-text-accent);
  }
  .anonymous-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .anonymous-form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .anonymous-form input,
  .anonymous-form textarea {
    font: inherit;
    padding: 0.5rem;
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    max-width: 100%;
  }
  /* The layout rules below set display, which would otherwise override the hidden attribute. */
  .comments [hidden] {
    display: none;
  }
  .comments-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .gate {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .stop-autoload {
    font: inherit;
    padding: 0;
    color: var(--sl-color-gray-3);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .show-comments,
  .anonymous-form button {
    align-self: flex-start;
    font: inherit;
    padding: 0.4rem 1rem;
    color: var(--sl-color-black);
    background: var(--sl-color-text-accent);
    border: 0;
    border-radius: 0.25rem;
    cursor: pointer;
  }
  .optional,
  .note {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .note,
  .status {
    margin: 0;
  }
</style>
