---
// Adds a site-wide navigation strip next to the site title so that the homepage,
// which has no sidebar, still shows that the site has depth. Hidden on narrow
// screens, where the doc pages keep Starlight's own menu.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const links = [
  { label: 'Get started', href: '/start/getting-started/' },
  { label: 'How it works', href: '/start/what-it-is/' },
  { label: 'Install', href: '/home-assistant/custom-integration/' },
  { label: 'Hardware', href: '/hardware/' },
  { label: 'Reference', href: '/reference/' },
];
const current = Astro.url.pathname;
---

<Default />
<nav class="site-nav" aria-label="Site">
  {links.map((l) => (
    <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>
      {l.label}
    </a>
  ))}
</nav>

<style>
  .site-nav {
    display: none;
    gap: 1.25rem;
    margin-inline-start: 1.5rem;
    align-items: center;
  }
  .site-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--sl-color-white);
  }
  @media (min-width: 72rem) {
    .site-nav {
      display: flex;
    }
  }
</style>
